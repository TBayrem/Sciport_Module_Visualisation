<%#
  ============================================================
  Datei: app/views/shared/_legend.html.erb

  Desc:
    Legende und Bedienhinweise als aufklappbares Feld
    ("ⓘ Legende"). Legend (legend.js) blendet das Feld beim
    Klick auf den Knopf ein und aus.

    Der Partial definiert außerdem die Symbole für Hochschule,
    Fachbereich (Untereinrichtung) und Person (<symbol>).
    NetworkView und TopicMapView zeichnen ihre Knoten mit
    <use> aus genau diesen Symbolen, und die Beispiele in der
    Legende verwenden dieselben CSS-Klassen wie die Grafiken.
    Legende und Grafik zeigen dadurch garantiert dieselben
    Zeichen und Farben.

  Locals (alle optional, Standard false):
    network    – Abschnitte für das Netzwerk zeigen
    clusters   – Abschnitt für die Clusterkarte zeigen
    similarity – Kanten der thematischen Ähnlichkeit zeigen
  ============================================================
%>
<% network    = local_assigns.fetch(:network, false) %>
<% clusters   = local_assigns.fetch(:clusters, false) %>
<% similarity = local_assigns.fetch(:similarity, false) %>

<%# Gemeinsame Symbole, unsichtbar; nur Vorlage für <use>. %>
<svg class="icon-defs" aria-hidden="true">
  <%# Hochschule: Gebäude mit Giebel und Säulen %>
  <symbol id="icon-facility" viewBox="-23 -23 46 38">
    <polygon points="-22,-7 0,-22 22,-7" fill="currentColor"/>
    <rect x="-20" y="-7" width="40" height="4" fill="currentColor"/>
    <rect x="-15" y="-2" width="4" height="12" fill="currentColor"/>
    <rect x="-6" y="-2" width="4" height="12" fill="currentColor"/>
    <rect x="3" y="-2" width="4" height="12" fill="currentColor"/>
    <rect x="12" y="-2" width="4" height="12" fill="currentColor"/>
    <rect x="-22" y="10" width="44" height="4.5" rx="1" fill="currentColor"/>
  </symbol>

  <%# Fachbereich / Untereinrichtung: aufgeschlagenes Buch im Kreis %>
  <symbol id="icon-department" viewBox="-15 -15 30 30">
    <circle r="14" fill="#fff" stroke="currentColor" stroke-width="1.5"/>
    <path d="M0,-5 C-3,-7.5 -6.5,-7.5 -9,-6.5 V6 C-6.5,5 -3,5 0,7.5 C3,5 6.5,5 9,6 V-6.5 C6.5,-7.5 3,-7.5 0,-5 Z"
          fill="currentColor"/>
    <path d="M0,-4.5 V7" stroke="#fff" stroke-width="1.2"/>
  </symbol>

  <%# Person: Kopf und Schultern im Kreis %>
  <symbol id="icon-person" viewBox="-15 -15 30 30">
    <circle r="14" fill="#fff" stroke="currentColor" stroke-width="1.5"/>
    <circle cy="-4.5" r="4.2" fill="currentColor"/>
    <path d="M-8,9 Q-8,0.5 0,0.5 Q8,0.5 8,9 Z" fill="currentColor"/>
  </symbol>
</svg>

<div class="legrow" data-legend>
  <button type="button" data-legend-toggle aria-expanded="false">ⓘ Legende</button>

  <div class="legpop <%= "wide" if network && clusters %>" data-legend-popup hidden>
    <button type="button" class="x" data-legend-close title="Schließen">×</button>

    <div class="legend-columns">
      <% if network %>
        <div>
          <h4>Netzwerk – Knoten</h4>
          <div class="li"><svg class="node node-facility" width="34" height="28"><use href="#icon-facility" x="3" y="0" width="28" height="28"/></svg><span>Hochschule (Größe = Anzahl Personen)</span></div>
          <div class="li"><svg class="node node-sub-facility" width="34" height="28"><use href="#icon-department" x="6" y="3" width="22" height="22"/></svg><span>Fachbereich / Untereinrichtung</span></div>
          <div class="li"><svg class="node node-person" width="34" height="28"><use href="#icon-person" x="8" y="5" width="18" height="18"/></svg><span>Person (Name per Tooltip)</span></div>
          <div class="li"><svg class="node node-person selected" width="34" height="34"><circle cx="17" cy="17" r="15" class="selection-ring"/><use href="#icon-person" x="5" y="5" width="24" height="24"/></svg><span>ausgewählt</span></div>

          <h4>Netzwerk – Kanten</h4>
          <div class="li"><svg width="34" height="14"><line x1="3" y1="7" x2="31" y2="7" class="edge-affiliation"/></svg><span>Zugehörigkeit: Fachbereich – Hochschule (ab Stufe 2), Person – Fachbereich bzw. Hochschule (ab Stufe 3)</span></div>
          <div class="li"><svg width="34" height="14"><g class="link link-project"><line x1="3" y1="7" x2="31" y2="7" class="link-line" style="stroke-width:3"/></g></svg><span>Kooperation über Projekte</span></div>
          <div class="li"><svg width="34" height="14"><g class="link link-publication"><line x1="3" y1="7" x2="31" y2="7" class="link-line" style="stroke-width:3"/></g></svg><span>Kooperation über Publikationen</span></div>
          <div class="li"><svg width="34" height="14"><g class="link link-both"><line x1="3" y1="7" x2="31" y2="7" class="link-line" style="stroke-width:3"/></g></svg><span>über Projekte und Publikationen</span></div>
          <% if similarity %>
            <div class="li"><svg width="34" height="14"><line x1="3" y1="7" x2="31" y2="7" class="edge-similarity"/></svg><span>thematische Ähnlichkeit ≥ Schwellenwert</span></div>
          <% end %>
          <div class="li"><span class="muted">Kooperationen: eine Kante je Paar, Linienstärke = Anzahl. Hover oder Klick auf eine Kante zeigt die Art.</span></div>

          <h4>Zoomstufen im Netzwerk</h4>
          <div class="li">
            <span>
              <b>Stufe 1</b> (herausgezoomt): Hochschulen, Kooperationen zwischen Hochschulen<br>
              <b>Stufe 2</b>: + Fachbereiche mit Kante zu ihrer Hochschule, Kooperationen zwischen Fachbereichen<br>
              <b>Stufe 3</b> (hineingezoomt): + Personen mit Kante zu ihrem Fachbereich bzw. ihrer Hochschule, Kooperationen zwischen Personen<br>
              <span class="muted">Ausgewählte Elemente bleiben auf jeder Stufe sichtbar.</span>
            </span>
          </div>
        </div>
      <% end %>

      <% if clusters %>
        <div>
          <h4>Clusterkarte</h4>
          <div class="li"><svg class="legend-icon topic-0" width="28" height="28"><use href="#icon-person"/></svg><span>Person, Farbe = Thema</span></div>
          <div class="li"><svg class="legend-icon noise" width="28" height="28"><use href="#icon-person"/></svg><span>Ausreißer (keinem Thema zugeordnet)</span></div>
          <div class="li"><svg width="40" height="24"><ellipse cx="20" cy="12" rx="17" ry="9" class="cluster-hull topic-0"/></svg><span>Thema (Cluster), anklickbar</span></div>
          <div class="li"><span class="muted">Nähe = ähnliches Forschungsprofil; die Achsen haben keine inhaltliche Bedeutung.</span></div>
        </div>
      <% end %>
    </div>

    <h4>Bedienung</h4>
    <div class="li">
      <span>
        Mausrad oder <b>+ / −</b>: zoomen · Ziehen: verschieben · <b>⌂</b>: Gesamtansicht<br>
        Hover: Name und Zugehörigkeit · Klick: Details im Infobereich
      </span>
    </div>
  </div>
</div>