<div id="<%= dom_id person %>">
  <div>
    <strong>First name:</strong>
    <%= person.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= person.last_name %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= person.title %>
  </div>

  <div>
    <strong>Email address:</strong>
    <%= person.email_address %>
  </div>

  <div>
    <strong>Phone number:</strong>
    <%= person.phone_number %>
  </div>

  <div>
    <strong>City:</strong>
    <%= person.city %>
  </div>

</div>
