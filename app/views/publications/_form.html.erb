<%= form_with(model: publication) do |form| %>
  <% if publication.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(publication.errors.count, "error") %> prohibited this publication from being saved:</h2>

      <ul>
        <% publication.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :authors, style: "display: block" %>
    <%= form.text_field :authors %>
  </div>

  <div>
    <%= form.label :year_of_publication, style: "display: block" %>
    <%= form.number_field :year_of_publication %>
  </div>

  <div>
    <%= form.label :publication_type, style: "display: block" %>
    <%= form.text_field :publication_type %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
